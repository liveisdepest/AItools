# ---- 服务 ----
NODE_ENV=development
PORT=8080

# ---- AI 工具站数据库（ai_tools 库，与老站 personal_website 分开）----
AI_DB_HOST=127.0.0.1
AI_DB_PORT=3306
AI_DB_USER=root
AI_DB_PASSWORD=123456
AI_DB_NAME=ai_tools
AI_DB_CONNECTION_LIMIT=10

# 数据库时区偏移，保证 DATETIME 读出来不会差 8 小时
DB_TIMEZONE=+08:00

# ---- 检索 ----
# like  : LIKE %关键词%，任何数据库都能跑（默认）
# match : MATCH ... AGAINST，需要 MySQL 8 的 ngram 分词器，中文更准
SEARCH_MODE=like

# ---- JWT（登录鉴权）----
# 必须换成随机字符串，否则启动时会打警告、且 token 可被伪造
JWT_SECRET=换成一个足够长的随机字符串
JWT_EXPIRES_IN=7d

# ---- 智能体调用额度（每人每天次数的上限）----
AGENT_DAILY_LIMIT=50
AGENT_ANON_DAILY_LIMIT=10

# ---- 智能体 · 大模型 ----
# 走 OpenAI 兼容协议，改这三个值就能换服务商：
#   DeepSeek : https://api.deepseek.com/v1        deepseek-chat
#   OpenAI   : https://api.openai.com/v1          gpt-4o-mini
#   月之暗面  : https://api.moonshot.cn/v1         moonshot-v1-8k
#   Ollama   : http://127.0.0.1:11434/v1          qwen2.5:7b
# 不填 LLM_API_KEY 时进入示例模式，界面能跑通但回复是模拟的
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL=deepseek-chat
# 图片分析需要多模态模型，留空则图片请求也会用上面的模型
LLM_VISION_MODEL=
LLM_TIMEOUT_MS=60000
